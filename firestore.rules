rules_version = '2';
// NexumCell — regras do Firestore
// Console Firebase → Firestore Database → Regras → cole tudo e clique em Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signed()  { return request.auth != null; }
    function anon()    { return signed() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    // "AAAA-MM" do relógio do servidor (UTC)
    function mesAtual() {
      return string(request.time.year()) + '-' + (request.time.month() < 10 ? '0' : '') + string(request.time.month());
    }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me()      { return get(userDoc()).data; }
    // E-mail do dono: entra em todos os portais com perfil de Dono
    function donoEmail() { return signed() && request.auth.token.email == 'wevellenerrera21@gmail.com'; }
    // loja bloqueada pelo Dono: gerente e vendedores dela perdem o acesso a tudo
    function lojaOk()  { return me().get('lojaBloqueada', false) != true; }
    function staff()   { return donoEmail() || (signed() && !anon() && exists(userDoc()) && me().ativo == true && lojaOk()); }
    function hasRole(rs) { return (donoEmail() && 'DONO' in rs) || (signed() && !anon() && exists(userDoc()) && me().ativo == true && lojaOk() && me().role in rs); }
    // gerente desativado ou de loja bloqueada: só consegue falar com o suporte pelo chat da tela de acesso restrito
    function gerenteBloqueado() { return signed() && !anon() && exists(userDoc()) && me().role == 'GERENTE' && (me().ativo != true || !lojaOk()); }
    function sistemaExiste() { return exists(/databases/$(database)/documents/config/sistema); }

    // ---------- Configuração ----------
    match /config/{id} {
      allow get: if signed() && !anon();
      allow list: if staff();
      allow create: if (id == 'sistema' && donoEmail()) || (id in ['contador', 'protocolos'] && staff());
      allow update: if hasRole(['DONO']) || (id in ['contador', 'protocolos'] && staff());
    }

    // ---------- Equipe ----------
    match /users/{uid} {
      allow read: if staff() || (signed() && request.auth.uid == uid);
      // só o Dono cria acessos (o gerente só cadastra o vendedor em cadastrosVendedor)
      allow create: if hasRole(['DONO']);
      allow update: if hasRole(['DONO'])
                    // a própria pessoa só marca que já trocou a senha temporária
                    || (signed() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['senhaTemporaria', 'senhaTrocadaEm', 'treinamento']))
                    // o gerente só ativa/desativa vendedor da loja dele, e não mexe em quem o Dono bloqueou
                    || (hasRole(['GERENTE']) && resource.data.role == 'VENDEDOR' && resource.data.lojaId == me().lojaId
                        && resource.data.get('bloqueadoPeloDono', false) != true
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo']));
      allow delete: if hasRole(['DONO']);
    }

    // ---------- Login por ID: ID → e-mail (só leitura de um ID por vez, sem listar) ----------
    match /logins/{codigo} {
      allow get: if true;
      allow list: if false;
      allow create, update: if hasRole(['DONO']) || (donoEmail() && request.resource.data.uid == request.auth.uid);
      allow delete: if hasRole(['DONO']);
    }

    match /lojas/{id} {
      allow read: if staff();
      allow write: if hasRole(['DONO']);
    }

    // ---------- Pedidos de licenças de venda (só o servidor grava; o Asaas confirma o pagamento) ----------
    match /licencasPedidos/{id} {
      allow read: if hasRole(['DONO', 'FINANCEIRO']) || (hasRole(['GERENTE']) && resource.data.lojaId == me().lojaId);
      allow write: if false;
    }

    // ---------- Empresas parceiras (SaaS: matriz e filiais, plano e mensalidade) ----------
    match /empresas/{id} {
      allow read: if hasRole(['DONO', 'FINANCEIRO']);
      allow write: if hasRole(['DONO']);
    }

    // ---------- Credenciamento de loja (link público → servidor grava; só o Dono vê e aprova) ----------
    // ---------- Fotos das lojas no cadastro (gravadas pelo servidor; só o Dono vê) ----------
    match /lojaFotos/{id} {
      allow read: if hasRole(['DONO']);
      allow write: if false;
    }

    match /solicitacoesLoja/{id} {
      allow read, update: if hasRole(['DONO']);
      allow create, delete: if false;
    }

    // ---------- Gerente cadastra o vendedor; o Dono aprova e cria o acesso ----------
    match /cadastrosVendedor/{id} {
      allow read: if hasRole(['DONO']) || (hasRole(['GERENTE']) && resource.data.lojaId == me().lojaId);
      allow create: if hasRole(['GERENTE']) && request.resource.data.lojaId == me().lojaId
                    && request.resource.data.gerenteUid == request.auth.uid && request.resource.data.status == 'PENDENTE';
      allow update: if hasRole(['DONO']);
      allow delete: if false;
    }

    // ---------- Comissão: o gerente paga com comprovante, o vendedor confirma, o Dono acompanha ----------
    match /comissoesPagas/{id} {
      allow read: if hasRole(['DONO', 'FINANCEIRO'])
                  || (hasRole(['GERENTE']) && resource.data.lojaId == me().lojaId)
                  || (hasRole(['VENDEDOR']) && resource.data.vendedorUid == request.auth.uid);
      allow create: if hasRole(['GERENTE']) && request.resource.data.lojaId == me().lojaId
                    && request.resource.data.gerenteUid == request.auth.uid
                    && request.resource.data.valor > 0 && request.resource.data.comprovante is string
                    && request.resource.data.confirmado == false && request.resource.data.contestado == false
                    && get(/databases/$(database)/documents/users/$(request.resource.data.vendedorUid)).data.lojaId == me().lojaId;
      allow update: if hasRole(['DONO'])
                    || (hasRole(['VENDEDOR']) && resource.data.vendedorUid == request.auth.uid
                        && resource.data.confirmado == false && resource.data.contestado == false
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmado', 'confirmadoEm', 'contestado', 'motivoContestacao', 'contestadoEm', 'assinatura', 'recibo']));
      allow delete: if false;
    }

    match /clientes/{cpf} {
      allow read: if staff();
      // o saldo de cashback é calculado só pelo servidor (ou dono/financeiro)
      allow create: if hasRole(['DONO', 'GERENTE', 'VENDEDOR', 'FINANCEIRO'])
                    && (hasRole(['DONO', 'FINANCEIRO']) || !('cashback' in request.resource.data));
      allow update: if hasRole(['DONO', 'GERENTE', 'VENDEDOR', 'FINANCEIRO'])
                    && (hasRole(['DONO', 'FINANCEIRO']) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cashback']));
    }

    // ---------- Catálogo de aparelhos e preços (só o Dono altera) ----------
    match /catalogo/{id} {
      allow read: if staff();
      allow write: if hasRole(['DONO']);
    }

    // ---------- Fotos do documento e biometria facial (só Dono e Financeiro veem) ----------
    match /docs/{id} {
      allow read: if hasRole(['DONO', 'FINANCEIRO']);
      allow create: if hasRole(['DONO', 'GERENTE', 'VENDEDOR']) && request.resource.data.vendedorUid == request.auth.uid;
      // dono pode apagar fotos e biometria (pedido de exclusão LGPD)
      allow update: if hasRole(['DONO']);
      allow delete: if false;
    }

    // ---------- Vendas / propostas ----------
    function catalogoPreco(d) { return get(/databases/$(database)/documents/catalogo/$(d.aparelho.catalogoId)).data.preco; }
    function entradaMin() { return get(/databases/$(database)/documents/config/sistema).data.get('entradaPct', 30); }
    function semMexer(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(campos) == false; }
    function jurosComVip(base, desc) { return desc <= base ? base - desc : 0; }
    function minhaVenda() { return hasRole(['VENDEDOR', 'GERENTE', 'DONO']) && resource.data.vendedorUid == request.auth.uid; }

    // contrato assinado: o cliente baixa pelo app da trava ou pelo portal (o ID é o token secreto do aparelho)
    match /contratos/{token} {
      allow get: if signed();
      allow list: if false;
      allow create, update: if staff();
      allow delete: if hasRole(['DONO']);
    }

    // retorno do reprovado: o vendedor anota que chamou o cliente de novo
    match /retornos/{id} {
      allow read: if staff();
      allow create, update: if staff() && request.resource.data.vendedorUid == request.auth.uid;
    }
    match /vendas/{id} {
      allow read: if hasRole(['DONO', 'FINANCEIRO', 'SUPORTE'])
                  || (hasRole(['GERENTE']) && resource.data.lojaId == me().lojaId)
                  || (hasRole(['VENDEDOR']) && resource.data.vendedorUid == request.auth.uid);
      // proposta nasce em análise, sem aparelho e sem valores
      allow create: if hasRole(['DONO', 'GERENTE', 'VENDEDOR'])
                    && (request.resource.data.status == 'ANALISE'
                        // venda a distância: nasce aguardando o cliente mandar documento e selfie pelo link
                        || (request.resource.data.status == 'REMOTA' && request.resource.data.remota.token is string && request.resource.data.remota.token.size() >= 20))
                    && request.resource.data.vendedorUid == request.auth.uid
                    && request.resource.data.aparelho == null && request.resource.data.valor == 0;
      allow update: if hasRole(['DONO', 'FINANCEIRO'])
                    // gerente acompanha a loja, mas não aprova crédito
                    || (hasRole(['GERENTE']) && resource.data.lojaId == me().lojaId
                        && request.resource.data.lojaId == resource.data.lojaId
                        // o repasse é lançado só pela NEXUM (dono/financeiro); o gerente só confirma que recebeu
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['repasse'])
                        && !(resource.data.status == 'ANALISE' && request.resource.data.status != 'ANALISE' && request.resource.data.status != 'CANCELADA'))
                    // suporte só registra as confirmações por WhatsApp
                    || (hasRole(['SUPORTE']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmacaoDados', 'confirmacaoEntrada']))
                    // vendedor: escolher aparelho (preço do catálogo, entrada mínima)
                    || (minhaVenda() && resource.data.status == 'APROVADA' && request.resource.data.status == 'APROVADA'
                        && semMexer(['analise', 'cliente', 'clienteCpf', 'vendedorUid', 'lojaId', 'vip'])
                        // iPhone: só com a aprovação da central e em loja liberada (o vendedor não mexe no pedido aqui)
                        && semMexer(['iphone'])
                        && (!(get(/databases/$(database)/documents/catalogo/$(request.resource.data.aparelho.catalogoId)).data.get('marca', '') in ['Apple', 'APPLE', 'apple'])
                            || (resource.data.get('iphone', {}).get('status', '') == 'APROVADA'
                                && resource.data.iphone.catalogoId == request.resource.data.aparelho.catalogoId
                                && request.resource.data.entrada >= resource.data.iphone.entrada
                                && request.resource.data.parcelas.size() <= resource.data.iphone.n
                                && get(/databases/$(database)/documents/lojas/$(resource.data.lojaId)).data.get('iphone', false) == true))
                        // valor = preço do catálogo + acessórios (no máximo 50% do aparelho)
                        && request.resource.data.valor == catalogoPreco(request.resource.data) + request.resource.data.get('acessoriosValor', 0)
                        && request.resource.data.get('acessoriosValor', 0) >= 0
                        && request.resource.data.get('acessoriosValor', 0) <= catalogoPreco(request.resource.data) * 0.5
                        // juros do catálogo (ou padrão), menos o desconto do programa VIP gravado na aprovação do crédito
                        // quinzenal só se o Dono ligou; juros do quinzenal vem do catálogo ou do padrão quinzenal
                        && (request.resource.data.get('frequencia', 'MENSAL') == 'MENSAL'
                            || (request.resource.data.get('frequencia', 'MENSAL') == 'QUINZENAL' && get(/databases/$(database)/documents/config/sistema).data.get('quinzenalAtivo', 'nao') == 'sim'))
                        && request.resource.data.juros == jurosComVip(
                             request.resource.data.get('frequencia', 'MENSAL') == 'QUINZENAL'
                               ? (get(/databases/$(database)/documents/catalogo/$(request.resource.data.aparelho.catalogoId)).data.get('jurosQuinzenal', null) == null
                                   ? get(/databases/$(database)/documents/config/sistema).data.get('jurosQuinzenalPct', 35)
                                   : get(/databases/$(database)/documents/catalogo/$(request.resource.data.aparelho.catalogoId)).data.jurosQuinzenal)
                               : (get(/databases/$(database)/documents/catalogo/$(request.resource.data.aparelho.catalogoId)).data.get('juros', null) == null
                                   ? get(/databases/$(database)/documents/config/sistema).data.get('jurosFinanciamentoPct', 25)
                                   : get(/databases/$(database)/documents/catalogo/$(request.resource.data.aparelho.catalogoId)).data.juros),
                             resource.data.get('vip', {}) == null ? 0 : resource.data.get('vip', {}).get('descontoJuros', 0))
                        // usado na entrada: no máximo 50% do valor
                        // (usado vem null quando não tem aparelho usado na entrada)
                        && (request.resource.data.get('usado', null) == null ? 0 : request.resource.data.usado.get('valor', 0)) <= request.resource.data.valor * 0.5
                        // produto sem trava exige entrada maior
                        && request.resource.data.entrada >= request.resource.data.valor * (get(/databases/$(database)/documents/catalogo/$(request.resource.data.aparelho.catalogoId)).data.get('semTrava', false) == true
                              ? get(/databases/$(database)/documents/config/sistema).data.get('entradaSemTravaPct', 50) : entradaMin()) / 100)
                        // contraproposta do dono: entrada mínima maior e/ou valor financiado máximo
                        && request.resource.data.entrada >= request.resource.data.valor * resource.data.analise.get('contraproposta', {}).get('entradaPct', 0) / 100
                        && (resource.data.analise.get('contraproposta', {}).get('limite', null) == null
                            || request.resource.data.valor - request.resource.data.entrada <= resource.data.analise.contraproposta.limite)
                        // cashback usado na entrada: no máximo o saldo do cliente
                        && (request.resource.data.get('cashbackUsado', 0) == 0
                            || (exists(/databases/$(database)/documents/clientes/$(resource.data.clienteCpf))
                                && request.resource.data.cashbackUsado <= get(/databases/$(database)/documents/clientes/$(resource.data.clienteCpf)).data.get('cashback', {}).get('saldo', 0)))
                    // vendedor: anota que chamou o cliente aprovado de volta (propostas para retomar)
                    || (minhaVenda() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['retomada']))
                    // vendedor: pede a análise do iPhone (nasce EM ANÁLISE, prazo da central) ou desiste do pedido
                    || (minhaVenda() && resource.data.status == 'APROVADA' && request.resource.data.status == 'APROVADA'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['iphone'])
                        && get(/databases/$(database)/documents/lojas/$(resource.data.lojaId)).data.get('iphone', false) == true
                        && ((request.resource.data.iphone.status == 'ANALISE'
                             && resource.data.get('iphone', {}).get('status', '') in ['', 'CANCELADA']
                             && request.resource.data.iphone.prazoEm > request.time.toMillis())
                            || (request.resource.data.iphone.status == 'CANCELADA' && resource.data.get('iphone', {}).get('status', '') == 'ANALISE')))
                    // vendedor: venda reprovada automaticamente por IMEI irregular (Anatel)
                    || (minhaVenda() && resource.data.status == 'APROVADA' && request.resource.data.status == 'REPROVADA'
                        && request.resource.data.reprovadoPorImei == true && semMexer(['analise', 'cliente', 'valor', 'entrada', 'parcelas']))
                    // vendedor: contrato assinado (sem mudar valores)
                    || (minhaVenda() && resource.data.status == 'APROVADA' && request.resource.data.status == 'AGUARDANDO_ENTRADA'
                        && semMexer(['analise', 'cliente', 'aparelho', 'valor', 'entrada', 'parcelas', 'nParcelas', 'valorParcela', 'juros']))
                    // vendedor: entrada recebida → aguardando a trava subir
                    || (minhaVenda() && resource.data.status == 'AGUARDANDO_ENTRADA' && request.resource.data.status == 'INSTALANDO'
                        && semMexer(['analise', 'cliente', 'aparelho', 'valor', 'entrada', 'parcelas', 'nParcelas', 'valorParcela', 'juros'])
                        && request.resource.data.entradaPaga.valor + (resource.data.get('usado', null) == null ? 0 : resource.data.usado.get('valor', 0)) >= resource.data.entrada)
                    // vendedor: produto SEM TRAVA (cadastrado assim pelo dono) fica ativo direto ao receber a entrada
                    || (minhaVenda() && resource.data.status == 'AGUARDANDO_ENTRADA' && request.resource.data.status == 'ATIVA'
                        && get(/databases/$(database)/documents/catalogo/$(resource.data.aparelho.catalogoId)).data.get('semTrava', false) == true
                        && semMexer(['analise', 'cliente', 'aparelho', 'valor', 'entrada', 'parcelas', 'nParcelas', 'valorParcela', 'juros'])
                        && request.resource.data.entradaPaga.valor + (resource.data.get('usado', null) == null ? 0 : resource.data.usado.get('valor', 0)) >= resource.data.entrada)
                    // vendedor: registra tentativas/alertas da instalação
                    || (minhaVenda() && resource.data.status == 'INSTALANDO' && request.resource.data.status == 'INSTALANDO'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['instalacao']))
                    // venda só é concluída quando o PRÓPRIO APARELHO confirmou a trava (check-in com administrador e IMEI certo)
                    || (minhaVenda() && resource.data.status == 'INSTALANDO' && request.resource.data.status == 'ATIVA'
                        && semMexer(['analise', 'cliente', 'aparelho', 'valor', 'entrada', 'parcelas', 'nParcelas', 'valorParcela', 'juros', 'aparelhoToken'])
                        // QR: Device Owner · link: administrador comum ativo (se o Dono permitir)
                        && (get(/databases/$(database)/documents/aparelhos/$(resource.data.aparelhoToken)).data.checkin.deviceOwner == true
                            || (get(/databases/$(database)/documents/aparelhos/$(resource.data.aparelhoToken)).data.checkin.get('modo', '') == 'link'
                                && get(/databases/$(database)/documents/aparelhos/$(resource.data.aparelhoToken)).data.checkin.get('adminAtivo', false) == true
                                && get(/databases/$(database)/documents/config/sistema).data.get('instalacaoLink', 'sim') != 'nao'))
                        && get(/databases/$(database)/documents/aparelhos/$(resource.data.aparelhoToken)).data.checkin.get('imeiConfere', true) == true);
      allow delete: if false;
    }

    // ---------- Aparelhos (trava) ----------
    // O ID do documento é um token secreto de 32 caracteres que só vai no QR code.
    match /aparelhos/{token} {
      allow get: if signed();   // o celular (login anônimo) lê só o próprio documento
      allow list: if hasRole(['DONO', 'FINANCEIRO', 'SUPORTE', 'VENDEDOR'])
                  || (hasRole(['GERENTE']) && resource.data.lojaId == me().lojaId);
      allow create: if hasRole(['DONO', 'GERENTE', 'VENDEDOR']);
      // remover a trava de vez (removerRemoto) é só do Dono; quitação/cancelamento removem sozinhos pelo sistema
      allow update: if (hasRole(['DONO'])
                    || ((hasRole(['FINANCEIRO', 'SUPORTE']) || (hasRole(['GERENTE']) && resource.data.lojaId == me().lojaId))
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['removerRemoto', 'removocao'])))
                    // o celular só pode atualizar o próprio "checkin"
                    || (anon() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkin']))
                    // portal do cliente: comunicar roubo, furto ou perda (uma vez; só a loja desfaz)
                    || (anon() && !('roubo' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roubo'])
                        && request.resource.data.roubo.keys().hasOnly(['tipo', 'data', 'local', 'bo', 'relato', 'em', 'via', 'localizar'])
                        && request.resource.data.roubo.tipo in ['Roubo', 'Furto', 'Perda'])
                    // app do cliente: liberação de confiança de 24 h, uma vez por mês (mês conferido pelo relógio do servidor)
                    || (anon() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confianca'])
                        && resource.data.get('confiancaMensal', 'sim') == 'sim'
                        && request.resource.data.confianca.keys().hasOnly(['ate', 'mes', 'em'])
                        && request.resource.data.confianca.mes == mesAtual()
                        && request.resource.data.confianca.ate <= request.time.toMillis() + 86400000 + 300000
                        && (!('confianca' in resource.data) || resource.data.confianca.mes != mesAtual()));
      allow delete: if false;
    }

    // ---------- Central de ajuda (artigos e vídeos) ----------
    match /ajuda/{id} {
      allow read: if staff();
      allow write: if hasRole(['DONO']);
    }

    // ---------- Atendimento (chat do vendedor/gerente com o assistente e o suporte) ----------
    match /atendimentos/{id} {
      allow read: if hasRole(['DONO', 'SUPORTE']) || ((staff() || gerenteBloqueado()) && resource.data.abertoPor == request.auth.uid);
      allow create: if (hasRole(['VENDEDOR', 'GERENTE']) && request.resource.data.abertoPor == request.auth.uid && request.resource.data.status == 'BOT')
                    || (gerenteBloqueado() && request.resource.data.abertoPor == request.auth.uid && request.resource.data.status == 'HUMANO' && request.resource.data.categoria == 'Acesso bloqueado');
      allow update: if hasRole(['DONO', 'SUPORTE'])
                    || (gerenteBloqueado() && resource.data.abertoPor == request.auth.uid && resource.data.status == 'HUMANO'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['msgs', 'naoLidoSuporte', 'naoLidoUser', 'atualizadoEm']))
                    // pesquisa de satisfação depois de concluído (uma vez)
                    || (staff() && resource.data.abertoPor == request.auth.uid && resource.data.status == 'CONCLUIDO' && !('pesquisa' in resource.data)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pesquisa', 'atualizadoEm', 'naoLidoUser']))
                    || (staff() && resource.data.abertoPor == request.auth.uid && resource.data.status != 'CONCLUIDO'
                        && request.resource.data.abertoPor == resource.data.abertoPor
                        && request.resource.data.status in ['BOT', 'HUMANO', 'CONCLUIDO']
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['protocolo', 'atendente', 'concluidoPor']));
      allow delete: if false;
    }

    // ---------- Licenças dos clientes SaaS (só usado no Firebase da NexumCell) ----------
    // Os portais de cada cliente leem a própria licença (sem login); só o Dono da NexumCell lista e altera.
    match /licencas/{slug} {
      allow get: if true;
      allow list, write: if hasRole(['DONO']);
    }

    // ---------- Segredo do código de liberação sem internet ----------
    // O app da trava cria uma vez (login anônimo); só a equipe lê para gerar o código. Ninguém altera.
    // ---------- Selfie tirada no app da trava (o aparelho grava; a loja confere antes de entregar) ----------
    match /selfiesApp/{tk} {
      allow get: if signed();
      allow list: if false;
      allow create: if anon() && exists(/databases/$(database)/documents/aparelhos/$(tk))
                    && request.resource.data.keys().hasOnly(['foto', 'em', 'modelo'])
                    && request.resource.data.foto is string && request.resource.data.foto.size() < 900000;
      allow update: if (anon() && !resource.data.get('conferida', false)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['foto', 'em', 'modelo'])
                        && request.resource.data.foto is string && request.resource.data.foto.size() < 900000)
                    || (staff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conferida', 'conferidaPor', 'conferidaEm']));
      allow delete: if hasRole(['DONO']);
    }

    match /chavesTrava/{token} {
      allow get: if hasRole(['DONO', 'FINANCEIRO', 'SUPORTE'])
                 || (hasRole(['GERENTE']) && get(/databases/$(database)/documents/aparelhos/$(token)).data.lojaId == me().lojaId);
      allow list: if false;
      allow create: if anon() && exists(/databases/$(database)/documents/aparelhos/$(token))
                    && request.resource.data.keys().hasOnly(['k', 'em'])
                    && request.resource.data.k is string && request.resource.data.k.size() >= 32 && request.resource.data.k.size() <= 128;
      allow update, delete: if false;
    }

    // ---------- Estoque por IMEI (ID do documento = IMEI 1) ----------
    match /estoque/{imei} {
      allow get: if staff();
      allow list: if hasRole(['DONO', 'FINANCEIRO', 'SUPORTE'])
                  || (hasRole(['GERENTE', 'VENDEDOR']) && resource.data.lojaId == me().lojaId)
                  || (hasRole(['GERENTE']) && resource.data.get('lojaDestino', '') == me().lojaId);
      allow create: if hasRole(['DONO']) || (hasRole(['GERENTE']) && request.resource.data.lojaId == me().lojaId);
      allow update: if hasRole(['DONO', 'FINANCEIRO'])
                    || (hasRole(['GERENTE']) && resource.data.lojaId == me().lojaId && request.resource.data.lojaId == me().lojaId)
                    // transferência: o gerente da loja de destino confirma o recebimento
                    || (hasRole(['GERENTE']) && resource.data.status == 'EM_TRANSITO' && resource.data.lojaDestino == me().lojaId && request.resource.data.lojaId == me().lojaId)
                    // gerente de outra loja pede a transferência de um aparelho disponível (só grava o pedido, em nome da própria loja)
                    || (hasRole(['GERENTE']) && resource.data.status == 'DISPONIVEL'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pedidoTransf'])
                        && request.resource.data.pedidoTransf.lojaId == me().lojaId)
                    // vendedor só marca como vendido o aparelho da própria loja
                    || (hasRole(['VENDEDOR']) && resource.data.lojaId == me().lojaId && resource.data.status == 'DISPONIVEL'
                        && request.resource.data.status == 'VENDIDO'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'vendaId', 'vendidoEm']));
      allow delete: if false;
    }

    // ---------- Lista negra (ID: cpf_..., tel_..., face_...) ----------
    match /listanegra/{id} {
      allow get: if staff();
      allow list: if hasRole(['DONO', 'FINANCEIRO', 'GERENTE']);
      allow create, update: if hasRole(['DONO', 'FINANCEIRO', 'GERENTE']);
      allow delete: if false;
    }

    // ---------- Metas do mês (ID: AAAA-MM) ----------
    // ---------- Ranking do mês (resumo: só primeiro nome e nº de vendas) ----------
    match /ranking/{id} {
      allow read: if staff();
      allow write: if hasRole(['DONO', 'FINANCEIRO']) || (hasRole(['GERENTE']) && id.matches('.*_' + me().lojaId));
    }

    match /metas/{mes} {
      allow read: if staff();
      allow write: if hasRole(['DONO', 'GERENTE']);
    }

    // ---------- Portal do cliente: chave = SHA-256(CPF + nascimento + 4 últimos dígitos do celular) ----------
    match /acessos/{chave} {
      allow get: if signed();
      allow list: if false;
      allow create, update: if staff();
      allow delete: if false;
    }

    // ---------- Biometria facial feita no celular pelo QR Code (ID = token secreto, vale 15 min) ----------
    // ---------- Vídeo de declaração do cliente (venda de iPhone) — 1 por venda ----------
    match /videos/{id} {
      allow read: if hasRole(['DONO', 'FINANCEIRO']);
      allow create, update: if hasRole(['DONO', 'GERENTE', 'VENDEDOR']) && request.resource.data.vendedorUid == request.auth.uid
                            && request.resource.data.video is string && request.resource.data.video.size() < 1000000;
      allow delete: if hasRole(['DONO']);
    }
    // gravação pelo celular do cliente (QR Code, vale 15 min; o vídeo é apagado do link depois de usado)
    match /videosQr/{tk} {
      allow get: if signed();
      allow list: if false;
      allow create: if staff() && request.resource.data.status == 'PENDENTE' && request.resource.data.vendedorUid == request.auth.uid;
      allow update: if (staff() && resource.data.vendedorUid == request.auth.uid)
                    || (anon() && resource.data.status == 'PENDENTE' && request.resource.data.status == 'ENVIADA'
                        && request.time.toMillis() < resource.data.expiraEm
                        && request.resource.data.video is string && request.resource.data.video.size() < 1000000
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'video', 'mime', 'dur', 'tam', 'enviadaEm', 'dispositivo']));
      allow delete: if staff() && resource.data.vendedorUid == request.auth.uid;
    }

    match /bios/{tk} {
      allow get: if signed();
      allow list: if false;
      allow create: if staff() && request.resource.data.status == 'PENDENTE' && request.resource.data.vendedorUid == request.auth.uid;
      allow update: if (staff() && resource.data.vendedorUid == request.auth.uid)
                    || (anon() && resource.data.status == 'PENDENTE' && request.resource.data.status == 'ENVIADA'
                        && request.time.toMillis() < resource.data.expiraEm
                        && request.resource.data.selfie is string && request.resource.data.selfie.size() < 450000
                        && (!('mosaico' in request.resource.data) || request.resource.data.mosaico.size() < 450000)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'selfie', 'mosaico', 'mov', 'enviadaEm', 'dispositivo']));
      allow delete: if staff() && resource.data.vendedorUid == request.auth.uid;
    }

    // ---------- Contrato assinado no celular do cliente (ID = token secreto do link) ----------
    match /assinaturas/{tk} {
      allow get: if signed();
      allow list: if false;
      allow create: if staff();
      allow update: if staff()
                    || (anon() && resource.data.status == 'PENDENTE' && request.resource.data.status == 'ASSINADO'
                        && request.time.toMillis() < resource.data.expiraEm
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assinatura', 'assinadoEm', 'aceites', 'dispositivo', 'nomeDigitado']));
      allow delete: if false;
    }

    // ---------- Fila de cobrança: contatos e promessas de pagamento (ID = venda) ----------
    match /cobrancas/{vendaId} {
      allow read, write: if hasRole(['DONO', 'FINANCEIRO', 'SUPORTE'])
                         || (hasRole(['GERENTE']) && (resource == null || resource.data.lojaId == me().lojaId)
                             && (request.resource == null || request.resource.data.lojaId == me().lojaId));
    }

    // ---------- Fechamento de caixa (ID = loja_AAAA-MM-DD) ----------
    match /caixas/{id} {
      allow read: if hasRole(['DONO', 'FINANCEIRO']) || (hasRole(['GERENTE']) && resource.data.lojaId == me().lojaId);
      allow create: if hasRole(['DONO']) || (hasRole(['GERENTE']) && request.resource.data.lojaId == me().lojaId);
      allow update: if hasRole(['DONO']);
      allow delete: if false;
    }

    // ---------- Pedidos do portal do cliente: assistência técnica e LGPD ----------
    match /pedidos/{id} {
      allow create: if signed()
                    && request.resource.data.keys().hasOnly(['tipo', 'token', 'vendaId', 'vendaNumero', 'lojaId', 'lojaNome', 'clienteNome', 'marca', 'modelo', 'imei', 'descricao', 'status', 'criadoEm', 'novoDia', 'fotos', 'dados'])
                    && request.resource.data.tipo in ['ASSISTENCIA', 'LGPD_COPIA', 'LGPD_EXCLUSAO', 'VENCIMENTO', 'PROTECAO', 'DADOS', 'UPGRADE']
                    && (!('fotos' in request.resource.data) || (request.resource.data.fotos is list && request.resource.data.fotos.size() <= 3))
                    && (!('dados' in request.resource.data) || request.resource.data.dados.keys().hasOnly(['tel1', 'tel2', 'cep', 'endereco', 'bairro', 'cidade', 'uf']))
                    && request.resource.data.status == 'ABERTO'
                    && request.resource.data.descricao.size() <= 600
                    && get(/databases/$(database)/documents/aparelhos/$(request.resource.data.token)).data.lojaId == request.resource.data.lojaId
                    && get(/databases/$(database)/documents/aparelhos/$(request.resource.data.token)).data.vendaId == request.resource.data.vendaId;
      allow read, update: if hasRole(['DONO', 'FINANCEIRO', 'SUPORTE'])
                          || (hasRole(['GERENTE']) && resource.data.lojaId == me().lojaId);
      allow delete: if false;
    }

    // ---------- Acessórios vendidos no mesmo contrato ----------
    match /acessorios/{id} {
      allow read: if staff();
      allow write: if hasRole(['DONO']);
    }

    // ---------- Vitrine pública (aparelhos e lojas para a pré-análise online) ----------
    match /publico/{id} {
      allow get: if signed();
      allow write: if hasRole(['DONO']);
    }

    // ---------- Pré-análise online (link público) ----------
    match /preanalises/{id} {
      allow get: if signed();
      allow list: if hasRole(['DONO', 'FINANCEIRO']) || (hasRole(['GERENTE', 'VENDEDOR']) && resource.data.lojaId == me().lojaId);
      // cliente pré-aprovado agenda a retirada pelo link
      allow update: if anon() && resource.data.status == 'PRE_APROVADO'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agendamento'])
                    && request.resource.data.agendamento.keys().hasOnly(['data', 'hora', 'em']);
      allow create: if signed()
                    && request.resource.data.keys().hasOnly(['nome', 'cpf', 'nasc', 'telefone', 'cidade', 'renda', 'profissao', 'aparelho', 'entrada', 'lojaId', 'lojaNome', 'aceiteLgpd', 'status', 'criadoEm'])
                    && request.resource.data.status == 'NOVA' && request.resource.data.aceiteLgpd == true
                    && request.resource.data.cpf is string && request.resource.data.cpf.size() == 11
                    && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
                    && request.resource.data.renda is number;
      allow update: if hasRole(['DONO', 'FINANCEIRO']) || (hasRole(['GERENTE']) && resource.data.lojaId == me().lojaId);
      allow delete: if false;
    }

    // ---------- Aprovação dupla: ações sensíveis esperam o dono ----------
    match /aprovacoes/{id} {
      allow create: if staff() && request.resource.data.solicitanteUid == request.auth.uid && request.resource.data.status == 'PENDENTE';
      allow read: if hasRole(['DONO']) || (staff() && resource.data.solicitanteUid == request.auth.uid);
      allow update: if hasRole(['DONO']);
      allow delete: if false;
    }

    // ---------- Contagem cega do estoque ----------
    match /contagens/{id} {
      allow create: if hasRole(['DONO']) || (hasRole(['GERENTE']) && request.resource.data.lojaId == me().lojaId);
      allow read: if hasRole(['DONO', 'FINANCEIRO']) || (hasRole(['GERENTE']) && resource.data.lojaId == me().lojaId);
      allow update, delete: if false;
    }

    // ---------- Conciliação pelo extrato do banco (ID = transação do banco) ----------
    match /conciliacoes/{id} {
      allow read, create: if hasRole(['DONO', 'FINANCEIRO']);
      allow update, delete: if false;
    }

    // ---------- Campanhas de recuperação ----------
    match /campanhas/{id} {
      allow read: if hasRole(['DONO', 'FINANCEIRO', 'GERENTE', 'SUPORTE']);
      allow create: if hasRole(['DONO']);
      allow update: if hasRole(['DONO']) || (hasRole(['FINANCEIRO', 'GERENTE', 'SUPORTE']) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enviados']));
    }

    // ---------- Cofre de chaves (Asaas): o Dono grava pelo painel, ninguém lê pelos portais (só o servidor) ----------
    match /segredos/{id} {
      allow read: if false;
      allow create, update: if hasRole(['DONO']);
      allow delete: if false;
    }

    // ---------- Resumo diário do dono (gravado pelo servidor às 19h) ----------
    match /notificacoes/{id} {
      allow read, write: if hasRole(['DONO']);
    }

    // ---------- Troca ou devolução em até X dias: gerente registra, dono/financeiro executam ----------
    match /trocas/{id} {
      allow read: if hasRole(['DONO', 'FINANCEIRO']) || (hasRole(['GERENTE']) && resource.data.lojaId == me().lojaId);
      allow create: if hasRole(['DONO', 'FINANCEIRO'])
                    || (hasRole(['GERENTE']) && request.resource.data.lojaId == me().lojaId && request.resource.data.status == 'PENDENTE');
      allow update: if hasRole(['DONO', 'FINANCEIRO']);
      allow delete: if false;
    }

    // ---------- Despesas da loja ----------
    match /despesas/{id} {
      allow read: if hasRole(['DONO', 'FINANCEIRO']) || (hasRole(['GERENTE']) && resource.data.lojaId == me().lojaId);
      allow create: if hasRole(['DONO', 'FINANCEIRO']) || (hasRole(['GERENTE']) && request.resource.data.lojaId == me().lojaId);
      allow update, delete: if hasRole(['DONO']);
    }

    // ---------- Estoque mínimo por loja (ID = loja) ----------
    match /estoqueMin/{lojaId} {
      allow read: if staff();
      allow write: if hasRole(['DONO']) || (hasRole(['GERENTE']) && lojaId == me().lojaId);
    }

    // ---------- Escala da semana (ID = loja_segunda-feira) ----------
    match /escalas/{id} {
      allow read: if staff();
      allow write: if hasRole(['DONO']) || (hasRole(['GERENTE']) && request.resource.data.lojaId == me().lojaId);
    }

    // ---------- Respostas prontas do suporte ----------
    match /respostas/{id} {
      allow read: if staff();
      allow write: if hasRole(['DONO', 'SUPORTE']);
    }

    // ---------- Nota do atendimento (ID = token do aparelho; uma por contrato) ----------
    match /avaliacoes/{token} {
      allow read: if staff();
      allow create: if signed() && request.resource.data.token == token
                    && request.resource.data.keys().hasOnly(['token', 'vendaId', 'lojaId', 'nota', 'comentario', 'em'])
                    && request.resource.data.nota is int && request.resource.data.nota >= 0 && request.resource.data.nota <= 10
                    && request.resource.data.comentario.size() <= 400
                    && get(/databases/$(database)/documents/aparelhos/$(token)).data.vendaId == request.resource.data.vendaId;
      allow update, delete: if false;
    }

    // ---------- Links de pagamento no cartão (gravados pelo servidor Asaas) ----------
    match /linksCartao/{id} {
      allow read: if hasRole(['DONO', 'FINANCEIRO']) || (hasRole(['GERENTE', 'VENDEDOR']) && resource.data.lojaId == me().lojaId);
      allow write: if false;
    }

    // ---------- Seminovos (aparelhos retomados) ----------
    match /seminovos/{id} {
      allow read: if hasRole(['DONO', 'GERENTE', 'FINANCEIRO']);
      allow write: if hasRole(['DONO', 'GERENTE', 'FINANCEIRO']);
      // vendedor: usado recebido como parte da entrada entra no estoque de seminovos da loja
      allow create: if hasRole(['VENDEDOR']) && request.resource.data.origem == 'TROCA' && request.resource.data.lojaId == me().lojaId && request.resource.data.status == 'DISPONIVEL';
    }

    // ---------- Suporte ----------
    match /chamados/{id} {
      allow read: if staff();
      allow create: if staff() && request.resource.data.abertoPor == request.auth.uid;
      allow update: if staff();
      allow delete: if hasRole(['DONO']);
    }

    // ---------- Auditoria (não pode ser alterada) ----------
    match /logs/{id} {
      allow read: if hasRole(['DONO', 'GERENTE', 'FINANCEIRO', 'SUPORTE']);
      allow create: if staff() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
